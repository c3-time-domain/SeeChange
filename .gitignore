##### some specific files we don't want in the repo

########################################
# Misc SeeChange debris

# Oh look, we have a temp dir
temp/*

# tests/improc/test_sky_flat.py makes and uses this;
#   we should move to using the actual temp dir
tests/improc/cache/*

# Somebody might have made a couple of these;
#   we do not want them in the archive
./local_overrides.yaml
./local_augments.yaml

# The "default" data directory... odd place
data/cache*
data/DECam_default_calibrators

# Test output directories
tests/plots
tests/temp_data
tests/test_filestore
tests/test_tempdata

# These next webap thingies are created
#   during webap install as symbolic
#   links into extern/rkwebutil, so
#   we don't want them in the archive.
webap/rkauth_flask.py
webap/static/resetpasswd_start.js
webap/static/rkauth.js
webap/static/rkwebutil.js
webap/static/svgplot.js

# docs build directory
docs/_build

### Stuff created by autoconf and ./configure
# None of this should be persistent
Makefile
aclocal.m4
autom4te.cache/
config.log
config.status
configure
improc/Makefile
install-sh
missing
models/Makefile
pipeline/Makefile
share/Makefile
util/Makefile

########################################
# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

